package domain

import "context"

type Repository interface {
 Save(ctx context.Context, entity *{{ .EntityName }}) error
 FindByID(ctx context.Context, id string) (*{{ .EntityName }}, error)
 List(ctx context.Context, pagination Pagination) (Page, error)
 Update(ctx context.Context, entity *{{ .EntityName }}) error
 Delete(ctx context.Context, id string) error
}

// Pagination uses zero-based offsets and bounds database query size.
type Pagination struct {
 Offset int `json:"offset"`
 Limit int `json:"limit"`
}
const DefaultLimit = 20
const MaxLimit = 100

func (p Pagination) Validate() error {
 if p.Offset < 0 || p.Limit < 1 || p.Limit > MaxLimit {
  return ErrInvalidPagination
 }
 return nil
}

type Page struct {
 Items []{{ .EntityName }} `json:"items"`
 Offset int `json:"offset"`
 Limit int `json:"limit"`
 Total int64 `json:"total"`
}
