package telemetry
import("github.com/gin-gonic/gin";"go.opentelemetry.io/otel";"go.opentelemetry.io/otel/attribute";"go.opentelemetry.io/otel/codes";"go.opentelemetry.io/otel/propagation";"go.opentelemetry.io/otel/trace")
// Middleware deliberately uses an allowlist of attributes. Generic HTTP
// instrumentation may capture the OAuth callback query (code/state).
func Middleware() gin.HandlerFunc {
	return func(c *gin.Context) {
		if !Enabled() || c.FullPath() == "/healthz" {
			c.Next()
			return
		}
		route := c.FullPath()
		if route == "" {
			route = "unmatched"
		}
		parent := propagation.TraceContext{}.Extract(c.Request.Context(), propagation.HeaderCarrier(c.Request.Header))
		ctx, span := otel.Tracer("modkit").Start(parent, c.Request.Method+" "+route,
			trace.WithSpanKind(trace.SpanKindServer),
			trace.WithAttributes(attribute.String("http.request.method", c.Request.Method), attribute.String("http.route", route)),
		)
		defer span.End()
		c.Request = c.Request.WithContext(ctx)
		c.Next()
		status := c.Writer.Status()
		span.SetAttributes(attribute.Int("http.response.status_code", status))
		if status >= 500 {
			span.SetStatus(codes.Error, "HTTP server error")
		}
	}
}
