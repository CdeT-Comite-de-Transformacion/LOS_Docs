package http

import (
	"fmt"

	"github.com/gin-gonic/gin"

	"{{ .ModulePath }}/internal/{{ .ModuleDir }}/application"
)

type Handler struct {
	service *application.Service
}

func NewHandler(service *application.Service) *Handler {
	return &Handler{service: service}
}

func (h *Handler) RegisterRoutes(router *gin.Engine) {
	router.POST("/{{ .ModuleDir }}", h.create)
}

func (h *Handler) create(c *gin.Context) {
	if err := h.service.Create(c.Request.Context(), c.Query("id")); err != nil {
		c.String(500, fmt.Sprintf("create {{ .ModuleDir }}: %v", err))
		return
	}
	c.Status(201)
}
