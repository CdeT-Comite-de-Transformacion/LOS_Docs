func Test{{ .EntityName }}ValidationAndPagination(t *testing.T){
 repo:=&{{ .EntityName }}TestRepository{};service:=New{{ .EntityName }}Service(repo);ctx:=context.Background()
 if !errors.Is(service.Create(ctx," "),domain.ErrInvalidID){t.Fatal("blank ID accepted")}
