  <diagram id="2Kvywzc8cu9yryJKB1pb" name="Documentación">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3_APS2tieVD863JFF9kh-3" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="360" width="501.74" x="120" y="80" as="geometry" />
        </mxCell>
        <mxCell id="3_APS2tieVD863JFF9kh-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontColor=#000099;" value="Flujo de trabajo GITFLOW" vertex="1">
          <mxGeometry height="30" width="206" x="120" y="40" as="geometry" />
        </mxCell>
        <mxCell id="3_APS2tieVD863JFF9kh-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="main&lt;div&gt;hotfix/descriptive_hotfix&lt;/div&gt;&lt;div&gt;release&lt;/div&gt;&lt;div&gt;develop&lt;/div&gt;&lt;div&gt;feature/descriptive_feature&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="190" x="120" y="480" as="geometry" />
        </mxCell>
        <mxCell id="3_APS2tieVD863JFF9kh-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontColor=#000099;" value="Estructura general repositorios" vertex="1">
          <mxGeometry height="30" width="290" x="120" y="640" as="geometry" />
        </mxCell>
        <mxCell id="3_APS2tieVD863JFF9kh-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;1. Manejo de .env&lt;/font&gt;&lt;/h1&gt;&lt;li&gt;Se sube al repo &lt;strong&gt;únicamente&lt;/strong&gt; &lt;code&gt;.env.example&lt;/code&gt;, con valores de ejemplo o placeholders, nunca valores reales. Su propósito es documentar &lt;em&gt;qué&lt;/em&gt; variables existen.&lt;/li&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Se manejan 2 documentos con información sensible:&amp;nbsp;&lt;code&gt;.env.dev&lt;font face=&quot;Helvetica&quot;&gt;&amp;nbsp;y&amp;nbsp;&lt;/font&gt;&lt;/code&gt;&lt;code&gt;.env.prod. &lt;font face=&quot;Helvetica&quot;&gt;Los cuales manejan las variables necesarias para el entorno de desarrollo y produccion respectivamente&lt;/font&gt;&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/code&gt;&lt;/li&gt;&lt;li&gt;Los archivos con valores reales&amp;nbsp;se mantienen &lt;strong&gt;locales y sin trackear&lt;/strong&gt;. El &lt;code&gt;.gitignore&lt;/code&gt; debe excluirlos explícitamente.&lt;/li&gt;" vertex="1">
          <mxGeometry height="200" width="510" x="120" y="680" as="geometry" />
        </mxCell>
        <mxCell id="3_APS2tieVD863JFF9kh-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;2. Contenido mínimo del README&lt;/font&gt;&lt;/h1&gt;&lt;li&gt;&lt;strong&gt;Qué es esto:&lt;/strong&gt; un párrafo en lenguaje sencillo explicando qué hace el LOS.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Prerrequisitos:&lt;/strong&gt; versionamiento, gestor de paquetes y dependencias del sistema si las hay.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Instalación:&lt;/strong&gt; pasos concretos.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Estructura de carpetas:&lt;/strong&gt; qué contiene cada directorio principal.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Procesos de despliegue:&lt;/strong&gt; cómo desplegar en local, dev y prod.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Referencia de variables de entorno:&lt;/strong&gt; una tabla corta que explique qué hace cada variable y de dónde sacar su valor.&lt;/li&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Stack tecnológico:&lt;/strong&gt; lista rápida de las tecnologías.&amp;nbsp;&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Testing:&lt;/strong&gt; cómo correr las pruebas.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Troubleshooting:&lt;/strong&gt; los dos o tres tropezones típicos del primer montaje.&lt;/li&gt;" vertex="1">
          <mxGeometry height="320" width="510" x="120" y="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
